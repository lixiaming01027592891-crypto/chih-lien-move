---
import Layout from '../layouts/Layout.astro';
---
<Layout title="聯絡我們｜志連精緻搬家｜台中搬家推薦" description="聯絡志連精緻搬家，提供免費搬家諮詢與估價服務。服務專線0919-073191，LINE線上諮詢，台中專業搬家公司推薦。">
  <section class="pt-32 pb-16" style="background: linear-gradient(180deg, #023E7D 0%, #001845 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-black text-white">聯絡我們</h1>
      <p class="mt-4 text-lg" style="color: #E0E7FF;">免費諮詢，專人為您服務</p>
    </div>
  </section>
  <section class="py-16 lg:py-24" style="background: #FFFBF5;">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- 免費估價表單 -->
        <div class="rounded-2xl p-8" style="background: #FFFFFF; border: 1px solid #FFE8CC; box-shadow: 0 4px 16px rgba(0,18,51,0.06);">
          <h3 class="text-xl font-bold mb-2" style="color: #001233;">免費估價・線上諮詢</h3>
          <p class="text-sm mb-6" style="color: #64748B;">填寫下方表單，我們將盡快與您聯繫。</p>
          <form action="https://formsubmit.co/service@clmove.com.tw" method="POST" class="space-y-4">
            <input type="hidden" name="_next" value="https://chihlienmoving.com/contact/thanks/" />
            <input type="hidden" name="_subject" value="志連精緻搬家－網站諮詢" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <input type="text" name="_honey" style="display:none" />
            <div>
              <label for="name" class="block text-sm font-medium mb-1" style="color: #334155;">姓名 <span style="color:#D4574A;">*</span></label>
              <input id="name" type="text" name="姓名" required autocomplete="name" class="w-full rounded-lg px-4 py-2.5 text-sm" style="border: 1px solid #E2D5C0; background: #FFFDF9; color: #001233;" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium mb-1" style="color: #334155;">聯絡電話 <span style="color:#D4574A;">*</span></label>
              <input id="phone" type="tel" name="電話" required autocomplete="tel" class="w-full rounded-lg px-4 py-2.5 text-sm" style="border: 1px solid #E2D5C0; background: #FFFDF9; color: #001233;" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium mb-1" style="color: #334155;">Email（選填）</label>
              <input id="email" type="email" name="Email" autocomplete="email" class="w-full rounded-lg px-4 py-2.5 text-sm" style="border: 1px solid #E2D5C0; background: #FFFDF9; color: #001233;" />
            </div>
            <div>
              <label for="movedate" class="block text-sm font-medium mb-1" style="color: #334155;">預計搬家日期（選填）</label>
              <input id="movedate" type="text" name="預計搬家日期" placeholder="例如：2026/08 中旬" class="w-full rounded-lg px-4 py-2.5 text-sm" style="border: 1px solid #E2D5C0; background: #FFFDF9; color: #001233;" />
            </div>
            <div>
              <label for="needs" class="block text-sm font-medium mb-1" style="color: #334155;">搬家需求</label>
              <textarea id="needs" name="搬家需求" rows="4" placeholder="搬家地點、樓層、有無電梯、大型物品（鋼琴／保險箱）等" class="w-full rounded-lg px-4 py-2.5 text-sm" style="border: 1px solid #E2D5C0; background: #FFFDF9; color: #001233;"></textarea>
            </div>
            <button type="submit" class="btn-primary w-full justify-center">送出諮詢</button>
          </form>
        </div>

        <!-- 聯絡資訊 + 服務時間 -->
        <div class="space-y-8">
          <div class="rounded-2xl p-8" style="background: #FFFFFF; border: 1px solid #FFE8CC; box-shadow: 0 4px 16px rgba(0,18,51,0.06);">
            <h3 class="text-xl font-bold mb-4" style="color: #001233;">聯絡資訊</h3>
            <ul class="space-y-4">
              <li class="flex items-center gap-3">
                <svg class="flex-shrink-0" style="color: #D4A843;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <a href="tel:0919073191" class="font-medium" style="color: #023E7D;">0919-073191</a>
              </li>
              <li class="flex items-center gap-3">
                <svg class="flex-shrink-0" style="color: #D4A843;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                <span style="color: #334155;">service@clmove.com.tw</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="flex-shrink-0 mt-0.5" style="color: #D4A843;" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                <span style="color: #334155;">台中市西屯區安和路99之12號1樓</span>
              </li>
            </ul>
            <div class="mt-6 flex gap-3">
              <a href="https://line.naver.jp/ti/p/~0919073191" target="_blank" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-white text-sm transition-all hover:opacity-90" style="background: #06C755;">LINE 諮詢</a>
              <a href="tel:0919073191" class="btn-primary text-sm py-2.5 px-5">立即來電</a>
            </div>
          </div>
          <div class="rounded-2xl p-8" style="background: #FFFFFF; border: 1px solid #FFE8CC; box-shadow: 0 4px 16px rgba(0,18,51,0.06);">
            <h3 class="text-xl font-bold mb-4" style="color: #001233;">服務時間</h3>
            <ul class="space-y-3 text-sm" style="color: #334155;">
              <li class="flex justify-between"><span>平日</span><span class="font-medium">24 小時</span></li>
              <li class="flex justify-between"><span>週六</span><span class="font-medium">24 小時</span></li>
              <li class="flex justify-between"><span>週日</span><span class="font-medium">24 小時</span></li>
            </ul>
            <p class="mt-6 text-xs" style="color: #64748B;">全年無休，隨時為您提供專業搬家服務</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
