---
import { type CollectionEntry, getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await post.render();

const categoryLabels: Record<string, string> = {
  move: '搬家服務',
  'home-moving': '住家搬家',
  'office-moving': '公司搬遷',
  'special-moving': '專項服務',
  'moving-guide': '搬家知識',
  recommend: '推薦',
  qna: '問答',
};
---

<Layout title={`${post.data.title}｜志連精緻搬家`} description={post.data.description}>
  <article class="pt-[72px]">
    <!-- Hero Section -->
    <div class="relative overflow-hidden" style="background: linear-gradient(180deg, #023E7D 0%, #001845 100%);">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 20% 80%, rgba(212,168,67,0.1) 0%, transparent 40%);"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative">
        <!-- Breadcrumb -->
        <nav class="mb-8">
          <ol class="flex items-center gap-2 text-sm text-white/50">
            <li><a href="/" class="hover:text-gold-400 transition-colors">首頁</a></li>
            <li>/</li>
            <li><a href="/blog/" class="hover:text-gold-400 transition-colors">部落格</a></li>
            <li>/</li>
            <li class="text-white/80">{categoryLabels[post.data.category] || post.data.category}</li>
          </ol>
        </nav>
        <!-- Category Badge -->
        <div class="inline-block px-4 py-1.5 bg-gold-400/20 border border-gold-400/30 rounded-full text-gold-300 text-sm font-medium mb-6">
          {categoryLabels[post.data.category] || post.data.category}
        </div>
        <!-- Title -->
        <h1 class="text-3xl lg:text-4xl font-bold text-white leading-tight mb-6">
          {post.data.title}
        </h1>
        <!-- Description -->
        <p class="text-lg text-white/70 leading-relaxed mb-8 max-w-3xl">
          {post.data.description}
        </p>
        <!-- Meta -->
        <div class="flex items-center gap-6 text-sm text-white/50">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            {post.data.author}
          </div>
        </div>
        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mt-6">
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 text-xs bg-white/10 text-white/60 rounded-full">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Article Content -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
      <div class="blog-content">
        <Content />
      </div>
      <!-- Back to Blog -->
      <div class="mt-16 pt-8 border-t border-gray-200">
        <a href="/blog/" class="inline-flex items-center gap-2 text-navy-600 hover:text-navy-800 font-medium transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          返回部落格
        </a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: #023E7D;
    margin: 2.5rem 0 1rem 0;
    padding-left: 0.75rem;
    border-left: 4px solid #2EC4B6;
  }
  .blog-content p {
    margin-bottom: 1rem;
    line-height: 1.8;
    color: #334155;
    text-align: justify;
  }
  .blog-content img {
    width: 100%;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
  }
  .blog-content strong {
    color: #001233;
  }
</style>
