---
import Layout from '../layouts/Layout.astro';

const portfolioItems = [
  {
    id: 1,
    title: '西屯區家庭搬家',
    category: '住家搬家',
    description: '協助客戶從舊社區搬至新大樓，含大型家具拆裝與精緻物品保護。',
    image: '/portfolio/portfolio-01.jpg',
  },
  {
    id: 2,
    title: '南屯區公寓搬遷',
    category: '住家搬家',
    description: '三樓無電梯搬運，妥善完成全套家具與家電搬遷。',
    image: '/portfolio/portfolio-07.jpg',
  },
  {
    id: 3,
    title: '科技廠辦公室遷移',
    category: '公司搬遷',
    description: '50人辦公室整體搬遷，含電腦設備與機密文件安全運送。',
    image: '/portfolio/portfolio-02.jpg',
  },
  {
    id: 4,
    title: '百貨專櫃調度',
    category: '公司搬遷',
    description: '商場內櫃位搬遷，於營業時間外高效完成。',
    image: '/portfolio/portfolio-09.jpg',
  },
  {
    id: 5,
    title: '平台鋼琴搬運',
    category: '精緻搬運',
    description: '專業鋼琴保護搬運，使用專業包材與防震措施。',
    image: '/portfolio/portfolio-03.jpg',
  },
  {
    id: 6,
    title: '古董家具運送',
    category: '精緻搬運',
    description: '珍貴木製家具保護，全程細心拆裝與包裝。',
    image: '/portfolio/portfolio-05.jpg',
  },
  {
    id: 7,
    title: '六樓吊車搬家',
    category: '吊車搬家',
    description: '高樓層家具吊掛，安全送達狹窄樓梯無法進入的物品。',
    image: '/portfolio/portfolio-04.jpg',
  },
  {
    id: 8,
    title: '工業設備搬移',
    category: '大型物品',
    description: '重型機械搬運，專業團隊使用特殊工具安全完成。',
    image: '/portfolio/portfolio-08.jpg',
  },
  {
    id: 9,
    title: '雙門冰箱搬運',
    category: '大型物品',
    description: '大型家電專業搬運，通過狹窄樓梯與轉角順利送達。',
    image: '/portfolio/portfolio-06.jpg',
  },
];

const categories = ['全部', '住家搬家', '公司搬遷', '精緻搬運', '吊車搬家', '大型物品'];

const stats = [
  { number: '18+', label: '年服務經驗' },
  { number: '10+', label: '專業車輛' },
  { number: '300+', label: '完成案件' },
  { number: '1,500+', label: '服務客戶' },
];
---

<Layout title="搬家實績｜志連精緻搬家｜台中搬家推薦" description="志連精緻搬家真實搬家案例，包含住家搬家、公司遷移、精緻搬運、吊車搬家、大型物品等各類搬家實績。18年經驗，專業團隊為您服務。">
  <!-- Hero Section -->
  <section class="relative flex items-center justify-center min-h-[360px]" style="background: linear-gradient(180deg, #023E7D 0%, #001845 100%); padding-top: 72px;">
    <!-- Decorative glow -->
    <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at center, rgba(212,168,67,0.08) 0%, transparent 70%);"></div>
    
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-16 md:py-20">
      <!-- Breadcrumb -->
      <nav class="mb-6" aria-label="麵包屑">
        <ol class="flex items-center justify-center gap-2 text-sm">
          <li>
            <a href="/" class="text-white/60 hover:text-gold-400 transition-colors">首頁</a>
          </li>
          <li class="text-white/40">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </li>
          <li class="text-gold-400 font-medium">搬家實績</li>
        </ol>
      </nav>
      
      <!-- Overline -->
      <p class="text-gold-400 text-sm font-medium tracking-[0.15em] mb-4" style="font-family: 'Inter', sans-serif;">PORTFOLIO</p>
      
      <!-- Heading -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-4" style="line-height: 1.1; letter-spacing: -0.02em;">
        搬家實績
      </h1>
      
      <!-- Subtitle -->
      <p class="text-lg md:text-xl max-w-2xl mx-auto" style="color: #E0E7FF; line-height: 1.75;">
        真實案例見證專業品質，每個搬遷專案都是我們的驕傲
      </p>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="py-16 md:py-24" style="background: #FFFBF5;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Filter Tabs -->
      <div class="flex flex-wrap justify-center gap-2 mb-12" id="filter-tabs">
        {categories.map((cat, index) => (
          <button
            type="button"
            data-category={cat}
            class={`filter-btn px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 ${
              index === 0
                ? 'text-white'
                : 'border text-[#334155] hover:bg-[rgba(2,62,125,0.08)] hover:border-[#0353A4]'
            }`}
            style={index === 0 ? 'background: #023E7D; border-color: #023E7D;' : 'border-color: #E2E8F0; background: transparent;'}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Portfolio Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="portfolio-grid">
        {portfolioItems.map((item) => (
          <article
            class="portfolio-card group bg-white rounded-2xl overflow-hidden transition-all duration-350"
            style="box-shadow: 0 4px 16px rgba(0,18,51,0.06);"
            data-category={item.category}
          >
            <!-- Image -->
            <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
              <img
                src={item.image}
                alt={item.title}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Hover Overlay -->
              <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(0,24,69,0.6);">
                <span class="px-6 py-3 rounded-lg font-semibold text-sm transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300" style="background: #D4A843; color: #001233;">
                  查看案例
                </span>
              </div>
            </div>
            
            <!-- Content -->
            <div class="p-5">
              <span class="text-xs font-semibold tracking-wide" style="color: #2EC4B6;">{item.category}</span>
              <h3 class="text-lg font-bold mt-1" style="color: #001233;">{item.title}</h3>
              <p class="text-sm mt-1.5 line-clamp-2" style="color: #64748B;">{item.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="py-12 md:py-16" style="background: #023E7D;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 md:gap-12">
        {stats.map((stat) => (
          <div class="text-center section-reveal">
            <p class="text-4xl md:text-5xl font-black mb-2" style="color: #D4A843; font-variant-numeric: tabular-nums;">
              {stat.number}
            </p>
            <p class="text-sm md:text-base" style="color: #E0E7FF;">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 md:py-20" style="background: #FFF5E6;">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center section-reveal">
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: #001233;">讓我們成為您的搬家夥伴</h2>
      <p class="text-base md:text-lg mb-8" style="color: #64748B;">無論大小專案，我們都以同樣的專業態度為您服務</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/contact/" class="btn-primary">
          立即聯絡我們
        </a>
        <a href="/services/" class="font-semibold text-sm transition-colors duration-200 hover:opacity-80" style="color: #2EC4B6;">
          了解更多服務 →
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Filter functionality
  const filterBtns = document.querySelectorAll<HTMLElement>('.filter-btn');
  const portfolioCards = document.querySelectorAll<HTMLElement>('.portfolio-card');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.dataset.category;

      // Update active button state
      filterBtns.forEach(b => {
        b.style.background = 'transparent';
        b.style.borderColor = '#E2E8F0';
        b.style.color = '#334155';
      });
      btn.style.background = '#023E7D';
      btn.style.borderColor = '#023E7D';
      btn.style.color = '#FFFFFF';

      // Filter cards
      portfolioCards.forEach(card => {
        const cardCategory = card.dataset.category;
        if (category === '全部' || cardCategory === category) {
          card.style.display = '';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => {
            card.style.transition = 'opacity 350ms ease, transform 350ms ease';
            card.style.opacity = '1';
            card.style.transform = 'scale(1)';
          }, 50);
        } else {
          card.style.transition = 'opacity 250ms ease, transform 250ms ease';
          card.style.opacity = '0';
          card.style.transform = 'scale(0.95)';
          setTimeout(() => {
            card.style.display = 'none';
          }, 250);
        }
      });
    });
  });
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
