---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搬家實績｜志連精緻搬家｜台中搬家推薦" description="志連精緻搬家多年累積的搬家實績，包含家庭搬家、公司遷移、精緻搬運等專業服務案例。">
  <section class="pt-32 pb-16" style="background: linear-gradient(180deg, #023E7D 0%, #001845 100%);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-black text-white">搬家實績</h1>
      <p class="mt-4 text-lg" style="color: #E0E7FF;">專業搬家服務的真實案例分享</p>
    </div>
  </section>
  <section class="py-16" style="background: #FFFBF5;">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xl" style="color: #64748B;">頁面建置中，敬請期待</p>
    </div>
  </section>
</Layout>
