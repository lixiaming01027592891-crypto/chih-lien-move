---
/**
 * 全站結構化資料（JSON-LD）。
 *
 * - 每頁固定輸出 MovingCompany（LocalBusiness 子型別），內容為站內可驗證的
 *   真實 NAP／服務／營業時間，讓 Google 能建立在地商家實體。
 * - 可透過 `extra` 傳入頁面專屬 schema（如 BlogPosting、BreadcrumbList）。
 *
 * 注意：不含 aggregateRating（站上無真實可驗證的評論來源，避免結構化資料造假），
 * 亦不含統一編號（站內未揭露，待客戶提供再補）。
 */
export interface Props {
  extra?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const { extra } = Astro.props;

const SITE = 'https://chihlienmoving.com';

const services = [
  '住家搬家',
  '公司搬遷',
  '精緻搬家',
  '鋼琴專業搬運',
  '吊車搬家',
  '大型物品搬運',
  '貨物運送',
];

const movingCompany = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  '@id': `${SITE}/#business`,
  name: '志連精緻搬家',
  description:
    '台中專業搬家公司，提供住家搬家、公司搬遷、精緻搬遷、鋼琴搬運、吊車搬家、大型物品搬運等服務。',
  url: SITE,
  telephone: '+886-919-073191',
  email: 'service@clmove.com.tw',
  image: `${SITE}/hero-bg.png`,
  logo: `${SITE}/favicon.svg`,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '安和路99之12號1樓',
    addressLocality: '西屯區',
    addressRegion: '台中市',
    addressCountry: 'TW',
  },
  hasMap: 'https://maps.app.goo.gl/evNjuWbHxmhEPobo9',
  areaServed: [
    { '@type': 'City', name: '台中市' },
    { '@type': 'Country', name: '台灣' },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  sameAs: ['https://line.naver.jp/ti/p/~0919073191'],
  makesOffer: services.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: s },
  })),
};

const extras = extra ? (Array.isArray(extra) ? extra : [extra]) : [];
---

<script type="application/ld+json" set:html={JSON.stringify(movingCompany)} />
{extras.map((node) => (
  <script type="application/ld+json" set:html={JSON.stringify(node)} />
))}
