---
const quickLinks = [
  { href: '/', label: '首頁' },
  { href: '/about/', label: '關於我們' },
  { href: '/services/', label: '服務項目' },
  { href: '/portfolio/', label: '搬家實績' },
  { href: '/news/', label: '最新消息' },
  { href: '/contact/', label: '聯絡我們' },
];

const services = [
  '搬家搬遷',
  '貨物運送',
  '公司/工廠遷移',
  '精緻搬遷',
  '大型物品搬移',
  '吊車搬家',
];
---

<footer class="relative" style="background: #001233; border-top: 3px solid #D4A843;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <div class="mb-4">
          <h3 class="text-white font-bold text-xl tracking-wide">志連精緻搬家</h3>
          <p class="text-gold-300 text-xs tracking-wider mt-1">政府合法立案 · 24小時服務</p>
        </div>
        <p class="text-white/60 text-sm leading-relaxed mb-6">
          志連精緻搬家以實務經驗為核心，長期服務住家、公司與各類搬遷需求，重視安全與細節控管，是您安心搬遷的首選團隊。
        </p>
        <div class="flex items-center gap-4">
          <a href="https://line.naver.jp/ti/p/~0919073191" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#06C755] flex items-center justify-center hover:scale-110 transition-transform" aria-label="LINE">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596l1.524 1.997c.281.366.02.896-.479.896a.635.635 0 0 1-.493-.232l-1.839-2.405v1.924c0 .345-.282.63-.631.63a.634.634 0 0 1-.63-.63V8.108c0-.345.282-.63.63-.63.349 0 .631.285.631.63v4.005l1.839-2.404a.635.635 0 0 1 .493-.232c.499 0 .76.53.479.896l-1.524 1.997c.258.086.432.326.432.596zm-2.902 0V8.108c0-.345.282-.63.63-.63.35 0 .632.285.632.63v4.771c0 .345-.282.63-.631.63a.634.634 0 0 1-.631-.63zm-2.476 0c0 .27-.174.51-.432.596l1.524 1.997c.281.366.02.896-.479.896a.635.635 0 0 1-.493-.232l-1.839-2.405v1.924c0 .345-.282.63-.631.63a.634.634 0 0 1-.63-.63V8.108c0-.345.282-.63.63-.63.349 0 .631.285.631.63v4.005l1.839-2.404a.635.635 0 0 1 .493-.232c.499 0 .76.53.479.896l-1.524 1.997c.258.086.432.326.432.596zm-2.902 0V8.108c0-.345.282-.63.63-.63.35 0 .632.285.632.63v4.771c0 .345-.282.63-.631.63a.634.634 0 0 1-.631-.63z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">快速連結</h4>
        <ul class="space-y-2">
          {quickLinks.map(link => (
            <li>
              <a href={link.href} class="text-white/60 hover:text-gold-400 text-sm transition-colors duration-200">{link.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">服務項目</h4>
        <ul class="space-y-2">
          {services.map(service => (
            <li>
              <a href="/services/" class="text-white/60 hover:text-gold-400 text-sm transition-colors duration-200">{service}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h4 class="text-white font-bold text-lg mb-4">聯絡資訊</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <svg class="text-gold-400 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div>
              <p class="text-white/40 text-xs">服務專線</p>
              <a href="tel:0919073191" class="text-white/90 hover:text-gold-400 text-sm transition-colors">0919-073191</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="text-gold-400 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <div>
              <p class="text-white/40 text-xs">客服信箱</p>
              <a href="mailto:service@clmove.com.tw" class="text-white/90 hover:text-gold-400 text-sm transition-colors">service@clmove.com.tw</a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <svg class="text-gold-400 mt-0.5 flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <p class="text-white/40 text-xs">營業據點</p>
              <a href="https://maps.app.goo.gl/evNjuWbHxmhEPobo9" target="_blank" rel="noopener noreferrer" class="text-white/90 hover:text-gold-400 text-sm transition-colors">台中市西屯區安和路99之12號1樓</a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/10">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <p class="text-white/40 text-sm">&copy; 志連精緻搬家｜台中搬家推薦 All Rights Reserved.</p>
        <div class="flex items-center gap-2 text-white/40 text-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          台中市西屯區安和路99之12號1樓
        </div>
      </div>
    </div>
  </div>
</footer>
